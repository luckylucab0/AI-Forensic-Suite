# Generated from the artifact catalogue. Do not edit by hand:
# run `afx export-collection` and commit the result.
# Catalogue digest: 61e249833468
#
# An empty result from this rule means the paths it searched held nothing. It does
# not mean the host is clean. Unverified catalogue entries, relocated data trees and
# the paths listed as not covered below are all reasons a used agent leaves no hit
# here. Where this matters, run the suite's own collector instead: it reads the
# relocation variables and the agents' own state files, which no static rule can.
#
# KAPE is Windows only. 49 of the 640 catalogue artifacts declare
# no Windows path and are therefore outside this target's scope entirely, which is a
# different thing from the per-artifact gaps listed below. For a macOS or Linux
# endpoint use the Velociraptor artifact or this suite's own collector.
#
# Not covered by this rule:
#   some of its paths are anchored at a working copy, whose location only the agent's own state file gives, so those are not in this rule. Its profile and system wide paths are. Run the suite's collector for the rest, which reads that state file
#     pi.agents_skills
#     pi.extensions
#     pi.prompts
#     pi.settings
#     pi.skills
Description: AI coding agent artifacts, pi
Author: agentforensics
Version: 1.0
Id: 780bc98b-f031-9787-7e4a-34b60e0c9bcd
RecreateDirectories: true
Targets:
    -
        Name: pi.agents_skills
        Category: instructions
        Path: C:\Users\%user%\.agents\skills
        FileMask: "*"
        Recursive: true
    -
        Name: pi.auth
        Category: credentials
        Path: C:\Users\%user%\.pi\agent
        FileMask: "auth.json"
        Recursive: false
    -
        Name: pi.bin
        Category: install_evidence
        Path: C:\Users\%user%\.pi\agent\bin
        FileMask: "*"
        Recursive: true
    -
        Name: pi.bin
        Category: install_evidence
        Path: C:\Users\%user%\.pi\agent\themes
        FileMask: "*"
        Recursive: true
    -
        Name: pi.bin
        Category: install_evidence
        Path: C:\Users\%user%\.pi\server
        FileMask: "*"
        Recursive: true
    -
        Name: pi.debug_log
        Category: log
        Path: C:\Users\%user%\.pi\agent
        FileMask: "pi-debug.log"
        Recursive: false
    -
        Name: pi.extensions
        Category: instructions
        Path: C:\Users\%user%\.pi\agent\extensions
        FileMask: "*"
        Recursive: true
    -
        Name: pi.extensions
        Category: instructions
        Path: C:\Users\%user%\.pi\agent\tools
        FileMask: "*"
        Recursive: true
    -
        Name: pi.models
        Category: config
        Path: C:\Users\%user%\.pi\agent
        FileMask: "models.json"
        Recursive: false
    -
        Name: pi.prompts
        Category: instructions
        Path: C:\Users\%user%\.pi\agent\prompts
        FileMask: "*"
        Recursive: true
    -
        Name: pi.sessions
        Category: transcript
        Path: C:\Users\%user%\.pi\agent\sessions\--*--
        FileMask: "*_*.jsonl"
        Recursive: false
    -
        Name: pi.settings
        Category: config
        Path: C:\Users\%user%\.pi\agent
        FileMask: "settings.json"
        Recursive: false
    -
        Name: pi.skills
        Category: instructions
        Path: C:\Users\%user%\.pi\agent\skills
        FileMask: "*"
        Recursive: true
