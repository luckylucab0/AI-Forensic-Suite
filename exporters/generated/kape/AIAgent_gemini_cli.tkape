# Generated from the artifact catalogue. Do not edit by hand:
# run `afx export-collection` and commit the result.
# Catalogue digest: dd8dcc055775
#
# An empty result from this rule means the paths it searched held nothing. It does
# not mean the host is clean. Unverified catalogue entries, relocated data trees and
# the paths listed as not covered below are all reasons a used agent leaves no hit
# here. Where this matters, run the suite's own collector instead: it reads the
# relocation variables and the agents' own state files, which no static rule can.
#
# KAPE is Windows only. 39 of the 612 catalogue artifacts declare
# no Windows path and are therefore outside this target's scope entirely, which is a
# different thing from the per-artifact gaps listed below. For a macOS or Linux
# endpoint use the Velociraptor artifact or this suite's own collector.
#
# Not covered by this rule:
#   anchored at a working copy, whose location only the agent's own state file gives: run the suite's collector, which reads it
#     gemini_cli.project_config
#   some of its paths are anchored at a working copy, whose location only the agent's own state file gives, so those are not in this rule. Its profile and system wide paths are. Run the suite's collector for the rest, which reads that state file
#     gemini_cli.agent_definitions
#     gemini_cli.commands
#     gemini_cli.policies
Description: AI coding agent artifacts, Gemini CLI
Author: agentforensics
Version: 1.0
Id: 1ce6417c-3a70-28e8-1e6b-7852ed396c75
RecreateDirectories: true
Targets:
    -
        Name: gemini_cli.agent_acknowledgments
        Category: permissions
        Path: C:\Users\%user%\.gemini\acknowledgments
        FileMask: "agents.json"
        Recursive: false
    -
        Name: gemini_cli.agent_definitions
        Category: instructions
        Path: C:\Users\%user%\.agents\skills
        FileMask: "*"
        Recursive: true
    -
        Name: gemini_cli.agent_definitions
        Category: instructions
        Path: C:\Users\%user%\.gemini\agents
        FileMask: "*"
        Recursive: true
    -
        Name: gemini_cli.agent_definitions
        Category: instructions
        Path: C:\Users\%user%\.gemini\skills
        FileMask: "*"
        Recursive: true
    -
        Name: gemini_cli.chats
        Category: transcript
        Path: C:\Users\%user%\.gemini\sessions
        FileMask: "*"
        Recursive: true
    -
        Name: gemini_cli.chats
        Category: transcript
        Path: C:\Users\%user%\.gemini\tmp\*\chats
        FileMask: "*"
        Recursive: true
    -
        Name: gemini_cli.commands
        Category: instructions
        Path: C:\Users\%user%\.gemini\commands
        FileMask: "*.toml"
        Recursive: true
    -
        Name: gemini_cli.credentials
        Category: credentials
        Path: C:\Users\%user%\.gemini
        FileMask: "oauth_creds.json"
        Recursive: false
    -
        Name: gemini_cli.google_accounts
        Category: config
        Path: C:\Users\%user%\.gemini
        FileMask: "google_accounts.json"
        Recursive: false
    -
        Name: gemini_cli.home_tree
        Category: config
        Path: C:\Users\%user%
        FileMask: ".gemini"
        Recursive: false
    -
        Name: gemini_cli.install_evidence
        Category: install_evidence
        Path: C:\Users\%user%\.gemini\installation_id
        FileMask: "*"
        Recursive: true
    -
        Name: gemini_cli.mcp_oauth_tokens
        Category: credentials
        Path: C:\Users\%user%\.gemini
        FileMask: "a2a-oauth-tokens.json"
        Recursive: false
    -
        Name: gemini_cli.mcp_oauth_tokens
        Category: credentials
        Path: C:\Users\%user%\.gemini
        FileMask: "mcp-oauth-tokens.json"
        Recursive: false
    -
        Name: gemini_cli.policies
        Category: permissions
        Path: C:\ProgramData\gemini-cli\policies
        FileMask: "*"
        Recursive: true
    -
        Name: gemini_cli.policies
        Category: permissions
        Path: C:\Users\%user%\.gemini\policies
        FileMask: "*"
        Recursive: true
    -
        Name: gemini_cli.policy_integrity
        Category: permissions
        Path: C:\Users\%user%\.gemini
        FileMask: "policy_integrity.json"
        Recursive: false
    -
        Name: gemini_cli.project_registry
        Category: config
        Path: C:\Users\%user%\.gemini
        FileMask: "projects.json"
        Recursive: false
    -
        Name: gemini_cli.project_runtime_trees
        Category: cache
        Path: C:\Users\%user%\.gemini\history
        FileMask: "*"
        Recursive: false
    -
        Name: gemini_cli.project_runtime_trees
        Category: cache
        Path: C:\Users\%user%\.gemini\tmp
        FileMask: "*"
        Recursive: false
    -
        Name: gemini_cli.prompt_history_log
        Category: prompt_history
        Path: C:\Users\%user%\.gemini\tmp\*
        FileMask: "logs.json"
        Recursive: false
    -
        Name: gemini_cli.shell_history
        Category: shell_history
        Path: C:\Users\%user%\.gemini\tmp\*\shell_history
        FileMask: "*"
        Recursive: true
    -
        Name: gemini_cli.system_settings
        Category: permissions
        Path: C:\ProgramData\gemini-cli
        FileMask: "settings.json"
        Recursive: false
    -
        Name: gemini_cli.system_settings
        Category: permissions
        Path: C:\ProgramData\gemini-cli
        FileMask: "system-defaults.json"
        Recursive: false
    -
        Name: gemini_cli.trusted_folders
        Category: permissions
        Path: C:\Users\%user%\.gemini
        FileMask: "trustedFolders.json"
        Recursive: false
    -
        Name: gemini_cli.user_settings
        Category: config
        Path: C:\Users\%user%\.gemini
        FileMask: "settings.json"
        Recursive: false
