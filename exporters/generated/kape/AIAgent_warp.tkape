# Generated from the artifact catalogue. Do not edit by hand:
# run `afx export-collection` and commit the result.
# Catalogue digest: 5a705decad88
#
# An empty result from this rule means the paths it searched held nothing. It does
# not mean the host is clean. Unverified catalogue entries, relocated data trees and
# the paths listed as not covered below are all reasons a used agent leaves no hit
# here. Where this matters, run the suite's own collector instead: it reads the
# relocation variables and the agents' own state files, which no static rule can.
#
# KAPE is Windows only. 40 of the 623 catalogue artifacts declare
# no Windows path and are therefore outside this target's scope entirely, which is a
# different thing from the per-artifact gaps listed below. For a macOS or Linux
# endpoint use the Velociraptor artifact or this suite's own collector.
#
# Not covered by this rule:
#   anchored at a working copy, whose location only the agent's own state file gives: run the suite's collector, which reads it
#     warp.project_rules
#   some of its paths are anchored at a working copy, whose location only the agent's own state file gives, so those are not in this rule. Its profile and system wide paths are. Run the suite's collector for the rest, which reads that state file
#     warp.mcp_config
#     warp.skills
Description: AI coding agent artifacts, Warp
Author: agentforensics
Version: 1.0
Id: 1e3c400a-e2a7-8609-3501-d6624310fdcf
RecreateDirectories: true
Targets:
    -
        Name: warp.cli_settings
        Category: permissions
        Path: C:\Users\%user%\.warp_cli
        FileMask: "settings.toml"
        Recursive: false
    -
        Name: warp.cli_settings
        Category: permissions
        Path: C:\Users\%user%\AppData\Local\warp\Warp\config\cli
        FileMask: "settings.toml"
        Recursive: false
    -
        Name: warp.global_rules
        Category: instructions
        Path: C:\Users\%user%\.agents
        FileMask: "AGENTS.md"
        Recursive: false
    -
        Name: warp.mcp_auth
        Category: credentials
        Path: C:\Users\%user%
        FileMask: ".mcp-auth"
        Recursive: false
    -
        Name: warp.mcp_config
        Category: mcp_config
        Path: C:\Users\%user%\.agents
        FileMask: ".mcp.json"
        Recursive: false
    -
        Name: warp.mcp_config
        Category: mcp_config
        Path: C:\Users\%user%\.warp
        FileMask: ".mcp.json"
        Recursive: false
    -
        Name: warp.mcp_config
        Category: mcp_config
        Path: C:\Users\%user%\.warp_cli
        FileMask: ".mcp.json"
        Recursive: false
    -
        Name: warp.mcp_logs
        Category: log
        Path: C:\Users\%user%\AppData\Local\warp\Warp\data\logs\mcp
        FileMask: "*"
        Recursive: true
    -
        Name: warp.skills
        Category: instructions
        Path: C:\Users\%user%\.agents\skills
        FileMask: "*"
        Recursive: true
    -
        Name: warp.skills
        Category: instructions
        Path: C:\Users\%user%\.claude\skills
        FileMask: "*"
        Recursive: true
    -
        Name: warp.skills
        Category: instructions
        Path: C:\Users\%user%\.codex\skills
        FileMask: "*"
        Recursive: true
    -
        Name: warp.skills
        Category: instructions
        Path: C:\Users\%user%\.copilot\skills
        FileMask: "*"
        Recursive: true
    -
        Name: warp.skills
        Category: instructions
        Path: C:\Users\%user%\.cursor\skills
        FileMask: "*"
        Recursive: true
    -
        Name: warp.skills
        Category: instructions
        Path: C:\Users\%user%\.factory\skills
        FileMask: "*"
        Recursive: true
    -
        Name: warp.skills
        Category: instructions
        Path: C:\Users\%user%\.gemini\skills
        FileMask: "*"
        Recursive: true
    -
        Name: warp.skills
        Category: instructions
        Path: C:\Users\%user%\.github\skills
        FileMask: "*"
        Recursive: true
    -
        Name: warp.skills
        Category: instructions
        Path: C:\Users\%user%\.opencode\skills
        FileMask: "*"
        Recursive: true
    -
        Name: warp.skills
        Category: instructions
        Path: C:\Users\%user%\.warp\skills
        FileMask: "*"
        Recursive: true
    -
        Name: warp.sqlite
        Category: prompt_history
        Path: C:\Users\%user%\AppData\Local\warp\Warp\data
        FileMask: "warp.sqlite"
        Recursive: false
    -
        Name: warp.sqlite
        Category: prompt_history
        Path: C:\Users\%user%\AppData\Local\warp\Warp\data
        FileMask: "warp.sqlite-shm"
        Recursive: false
    -
        Name: warp.sqlite
        Category: prompt_history
        Path: C:\Users\%user%\AppData\Local\warp\Warp\data
        FileMask: "warp.sqlite-wal"
        Recursive: false
