# Generated from the artifact catalogue. Do not edit by hand:
# run `afx export-collection` and commit the result.
# Catalogue digest: 1c3de2ec5a69
#
# An empty result from this rule means the paths it searched held nothing. It does
# not mean the host is clean. Unverified catalogue entries, relocated data trees and
# the paths listed as not covered below are all reasons a used agent leaves no hit
# here. Where this matters, run the suite's own collector instead: it reads the
# relocation variables and the agents' own state files, which no static rule can.
#
# KAPE is Windows only. 33 of the 524 catalogue artifacts declare
# no Windows path and are therefore outside this target's scope entirely, which is a
# different thing from the per-artifact gaps listed below. For a macOS or Linux
# endpoint use the Velociraptor artifact or this suite's own collector.
#
# Not covered by this rule:
#   anchored at a working copy, whose location only the agent's own state file gives: run the suite's collector, which reads it
#     jetbrains_ai.mcp_config
Description: AI coding agent artifacts, JetBrains AI Assistant
Author: agentforensics
Version: 1.0
Id: b1f09235-64f5-bf3c-2072-51a105223802
RecreateDirectories: true
Targets:
    -
        Name: jetbrains_ai.aia_task_history
        Category: transcript
        Path: C:\Users\%user%\AppData\Roaming\JetBrains\aia-task-history
        FileMask: "*"
        Recursive: true
    -
        Name: jetbrains_ai.base_directories
        Category: config
        Path: C:\Users\%user%\AppData\Local\JetBrains
        FileMask: "*"
        Recursive: true
    -
        Name: jetbrains_ai.base_directories
        Category: config
        Path: C:\Users\%user%\AppData\Local\JetBrains\log
        FileMask: "*"
        Recursive: true
    -
        Name: jetbrains_ai.base_directories
        Category: config
        Path: C:\Users\%user%\AppData\Roaming\JetBrains
        FileMask: "*"
        Recursive: true
    -
        Name: jetbrains_ai.base_directories
        Category: config
        Path: C:\Users\%user%\AppData\Roaming\JetBrains\plugins
        FileMask: "*"
        Recursive: true
    -
        Name: jetbrains_ai.ide_logs
        Category: log
        Path: C:\Users\%user%\AppData\Local\JetBrains\log
        FileMask: "idea.log"
        Recursive: true
    -
        Name: jetbrains_ai.log_data
        Category: log
        Path: C:\Users\%user%\AppData\Local\JetBrains\ai-assistant-log-data
        FileMask: "*"
        Recursive: true
    -
        Name: jetbrains_ai.password_safe
        Category: credentials
        Path: C:\Users\%user%\AppData\Roaming\JetBrains
        FileMask: "c.kdbx"
        Recursive: true
    -
        Name: jetbrains_ai.password_safe
        Category: credentials
        Path: C:\Users\%user%\AppData\Roaming\JetBrains
        FileMask: "c.pwd"
        Recursive: true
