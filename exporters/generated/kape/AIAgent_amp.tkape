# Generated from the artifact catalogue. Do not edit by hand:
# run `afx export-collection` and commit the result.
# Catalogue digest: a79339ed4b97
#
# An empty result from this rule means the paths it searched held nothing. It does
# not mean the host is clean. Unverified catalogue entries, relocated data trees and
# the paths listed as not covered below are all reasons a used agent leaves no hit
# here. Where this matters, run the suite's own collector instead: it reads the
# relocation variables and the agents' own state files, which no static rule can.
#
# KAPE is Windows only. 32 of the 571 catalogue artifacts declare
# no Windows path and are therefore outside this target's scope entirely, which is a
# different thing from the per-artifact gaps listed below. For a macOS or Linux
# endpoint use the Velociraptor artifact or this suite's own collector.
#
# Not covered by this rule:
#   anchored at a working copy, whose location only the agent's own state file gives: run the suite's collector, which reads it
#     amp.settings
#     amp.skills
#   no Windows path that a drive-and-mask target can express
#     amp.continuations
#     amp.session_pointer
Description: AI coding agent artifacts, Amp
Author: agentforensics
Version: 1.0
Id: f67f5d7d-c703-48d0-17d4-a39ffd1e8054
RecreateDirectories: true
Targets:
    -
        Name: amp.ledger
        Category: log
        Path: C:\Users\%user%\AppData\Roaming\amp
        FileMask: "ledger.jsonl"
        Recursive: false
    -
        Name: amp.secrets
        Category: credentials
        Path: C:\Users\%user%\.amp\oauth
        FileMask: "*"
        Recursive: true
    -
        Name: amp.secrets
        Category: credentials
        Path: C:\Users\%user%\AppData\Roaming\amp
        FileMask: "secrets.json"
        Recursive: false
    -
        Name: amp.threads
        Category: transcript
        Path: C:\Users\%user%\AppData\Roaming\amp\threads
        FileMask: "T-*.json"
        Recursive: false
