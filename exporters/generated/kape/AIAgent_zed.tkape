# Generated from the artifact catalogue. Do not edit by hand:
# run `afx export-collection` and commit the result.
# Catalogue digest: d3e9da90b842
#
# An empty result from this rule means the paths it searched held nothing. It does
# not mean the host is clean. Unverified catalogue entries, relocated data trees and
# the paths listed as not covered below are all reasons a used agent leaves no hit
# here. Where this matters, run the suite's own collector instead: it reads the
# relocation variables and the agents' own state files, which no static rule can.
#
# KAPE is Windows only. 33 of the 512 catalogue artifacts declare
# no Windows path and are therefore outside this target's scope entirely, which is a
# different thing from the per-artifact gaps listed below. For a macOS or Linux
# endpoint use the Velociraptor artifact or this suite's own collector.
#
# Not covered by this rule:
#   anchored at a working copy, whose location only the agent's own state file gives: run the suite's collector, which reads it
#     zed.settings
Description: AI coding agent artifacts, Zed
Author: agentforensics
Version: 1.0
Id: cec7d35b-cac7-8e01-9330-36b6b47bc9ee
RecreateDirectories: true
Targets:
    -
        Name: zed.extensions
        Category: install_evidence
        Path: C:\Users\%user%\AppData\Local\Zed\debug_adapters
        FileMask: "*"
        Recursive: true
    -
        Name: zed.extensions
        Category: install_evidence
        Path: C:\Users\%user%\AppData\Local\Zed\extensions
        FileMask: "*"
        Recursive: true
    -
        Name: zed.extensions
        Category: install_evidence
        Path: C:\Users\%user%\AppData\Local\Zed\external_agents
        FileMask: "*"
        Recursive: true
    -
        Name: zed.extensions
        Category: install_evidence
        Path: C:\Users\%user%\AppData\Local\Zed\prompt_overrides
        FileMask: "*"
        Recursive: true
    -
        Name: zed.logs
        Category: log
        Path: C:\Users\%user%\AppData\Local\Zed\logs
        FileMask: "*"
        Recursive: true
    -
        Name: zed.prompt_library
        Category: instructions
        Path: C:\Users\%user%\AppData\Local\Zed\prompts
        FileMask: "*"
        Recursive: true
    -
        Name: zed.sidebar_threads
        Category: transcript
        Path: C:\Users\%user%\AppData\Local\Zed\db\0-*
        FileMask: "db.sqlite"
        Recursive: false
    -
        Name: zed.sidebar_threads
        Category: transcript
        Path: C:\Users\%user%\AppData\Local\Zed\db\0-*
        FileMask: "db.sqlite-shm"
        Recursive: false
    -
        Name: zed.sidebar_threads
        Category: transcript
        Path: C:\Users\%user%\AppData\Local\Zed\db\0-*
        FileMask: "db.sqlite-wal"
        Recursive: false
    -
        Name: zed.threads_db
        Category: transcript
        Path: C:\Users\%user%\AppData\Local\Zed\threads
        FileMask: "threads.db"
        Recursive: false
    -
        Name: zed.threads_db
        Category: transcript
        Path: C:\Users\%user%\AppData\Local\Zed\threads
        FileMask: "threads.db-shm"
        Recursive: false
    -
        Name: zed.threads_db
        Category: transcript
        Path: C:\Users\%user%\AppData\Local\Zed\threads
        FileMask: "threads.db-wal"
        Recursive: false
